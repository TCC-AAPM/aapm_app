{
  "expo": {
    "name": "AAPM",
    "slug": "aapm-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "imageWidth": 288,
      "resizeMode": "contain",
      "backgroundColor": "#004AAD"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D3FAA"
      },
      "package": "com.anonymous.aapmapp"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ]
  }
}
